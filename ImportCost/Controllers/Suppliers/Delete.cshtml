@using Application.ViewModel.Suppliers;
@model ViewModelSuppliersDelete;

<div class="card border-0 shadow-none text-center">

    <div class="card-header border-0 bg-transparent pb-0 mt-3">
        <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger rounded-circle mb-3" style="width: 70px; height: 70px;">
            <i class="bi bi-exclamation-triangle fs-1"></i>
        </div>
        <h5 class="fw-bold text-dark mb-0">Confirmar Eliminación</h5>
    </div>
    <div class="card-body pt-3 pb-4">
        <p class="text-secondary mb-2">¿Estás seguro de que deseas eliminar permanentemente el proveedor?</p>

        <p class="fw-bold text-dark fs-5 p-2 bg-light rounded-3 d-inline-block border">
            @Model.NameSupplier
        </p>

        <p class="text-muted small mt-2 mb-0">Esta acción no se puede deshacer y los datos se perderán.</p>
    </div>

    <form asp-controller="Suppliers" asp-action="Delete" method="POST">

        <input type="hidden" asp-for="Key" />
        <input type="hidden" asp-for="NameSupplier" />

        <div class="modal-footer mt-0 border-0 pt-0 d-flex justify-content-center gap-2 pb-4">
            <a asp-controller="Suppliers" asp-action="Index" class="btn btn-light rounded-3 px-4 shadow-sm fw-semibold">
                Volver Atrás
            </a>
            <button type="submit" class="btn btn-danger rounded-3 px-4 shadow-sm fw-semibold d-inline-flex align-items-center gap-2">
                <i class="bi bi-trash3"></i> Sí, Eliminar
            </button>
        </div>
    </form>

</div>