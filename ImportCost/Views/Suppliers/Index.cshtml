@using Application.ViewModel.Suppliers;
@model List<ViewModelSuppliers>;

@{
    ViewData["Title"] = "Gestión de Proveedores";
}

<div class="container-fluid py-4">

    @* Mensaje que retorna el controller según lo que haya pasado *@
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-@TempData["TypeAlert"] w-auto alert-dismissible fade show shadow-sm border-0" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-4 align-items-center">
        <div class="col-12 col-md-6 col-lg-4 mb-3 mb-md-0">
            <div class="input-group shadow-sm rounded-3 overflow-hidden bg-white">
                <span class="input-group-text bg-white border-0 text-muted ps-3">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" id="liveSearch" class="form-control border-0 shadow-none py-2" placeholder="Buscar proveedor..." maxlength="20" />
            </div>
        </div>

        <div class="col-12 col-md-6 text-md-end">
            <a asp-controller="Suppliers" asp-action="Create"
               class="btn btn-primary px-4 py-2 fw-semibold rounded-3 shadow-sm d-inline-flex align-items-center gap-2">
                <i class="bi bi-truck"></i>
                Agregar Proveedor
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 bg-light">
        <div class="row g-0 align-items-center">
            <div class="col-md-8 p-4 p-md-5">
                <h2 class="h4 fw-bold text-dark mb-2">Directorio de Proveedores</h2>
                <p class="text-secondary mb-3 text-wrap">
                    Gestiona los proveedores externos del sistema. Controla sus datos de contacto, país de origen y moneda principal.
                </p>
            </div>
        </div>
    </div>

    <div class="row gap-4 gap-lg-0">
        <div class="col-12 col-lg-2">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="list-group list-group-flush rounded-3">
                    <a asp-controller="Suppliers" asp-action="Index" class="list-group-item list-group-item-action active fw-semibold border-0 py-3 d-flex align-items-center gap-2">
                        <i class="bi bi-truck"></i> Proveedores
                    </a>
                    <a asp-controller="Countrys" asp-action="Index" class="list-group-item list-group-item-action border-0 py-3 text-secondary d-flex align-items-center gap-2">
                        <i class="bi bi-globe-americas"></i> Países
                    </a>
                    <a asp-controller="Currency" asp-action="Index" class="list-group-item list-group-item-action border-0 py-3 text-secondary d-flex align-items-center gap-2">
                        <i class="bi bi-tags"></i> Monedas
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-10">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="suppliersTable">
                        <thead class="table-light text-secondary text-uppercase" style="font-size: 0.67rem;">
                            <tr>
                                <th class="py-3 ps-4 fw-semibold">Nombre</th>
                                <th class="py-3 fw-semibold">País</th>
                                <th class="py-3 fw-semibold">Teléfono</th>
                                <th class="py-3 fw-semibold">Email</th>
                                <th class="py-3 fw-semibold">Moneda</th>
                                <th class="py-3 fw-semibold">Estado</th>
                                <th class="py-3 text-end pe-4 fw-semibold">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="border-top-0" id="tableBody">
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4 fw-semibold text-dark">@item.Name</td>
                                        <td class="text-secondary small">@item.NameCountry</td>
                                        <td class="text-secondary small">@item.PhoneNumber</td>
                                        <td class="text-secondary small">@item.Email</td>
                                        <td class="text-secondary small">
                                            <span class="badge bg-dark bg-opacity-10 text-dark border px-2 py-1 rounded-2">@item.MainCurrency</span>
                                        </td>
                                        <td class="text-secondary small">
                                            <span class="badge @(item.State ? "bg-primary" : "bg-danger") bg-opacity-10 text-@(item.State ? "primary" : "danger") border border-opacity-25 px-2 py-1 rounded-2 fw-normal">
                                                @(item.State ? "Activo" : "Inactivo")
                                            </span>
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="btn-group shadow-sm rounded-3">
                                                <a asp-controller="Suppliers" asp-action="Edit" asp-route-id="@item.key" class="btn btn-sm btn-light text-success border-end" title="Editar">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                <a asp-controller="Suppliers" asp-action="Delete" asp-route-id="@item.key" class="btn btn-sm btn-light text-danger" title="Eliminar">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="bi bi-truck fs-2 d-block mb-2 opacity-50"></i>
                                        No hay proveedores registrados.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card-footer bg-white border-top-0 p-3 d-flex justify-content-between align-items-center">
                    <span class="text-muted small">Mostrando @(Model?.Count ?? 0) proveedores</span>
                </div>
            </div>
        </div>
    </div>
</div>