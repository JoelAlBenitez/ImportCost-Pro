@using Application.ViewModel.ExchangeRates
@model ViewModelExchangeRateSave

@{
    ViewData["Title"] = "Registrar Tasa de Cambio";
}

<div class="card-header bg-white border-0 p-0 mb-4">
    <h5 class="fw-bold text-dark">Registrar Nueva Tasa de Cambio</h5>
</div>

@* Mensaje de alerta *@
@if (TempData["Message"] != null)
{
    <div class="alert alert-@TempData["TypeAlert"] w-auto alert-dismissible fade show shadow-sm border-0" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form asp-controller="ExchangeRates" asp-action="Create" method="POST">
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="SourceCurrencyId" class="form-label fw-semibold small text-muted">Moneda Origen (Base)</label>
            <select asp-for="SourceCurrencyId" class="form-select rounded-3">
                <option value="">Seleccione moneda...</option>
                @if (Model.Currencies != null)
                {
                    foreach (var c in Model.Currencies)
                    {
                        <option value="@c.Id">@c.NameCurrency</option>
                    }
                }
            </select>
            <span asp-validation-for="SourceCurrencyId" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="DestinationCurrencyId" class="form-label fw-semibold small text-muted">Moneda Destino (Meta)</label>
            <select asp-for="DestinationCurrencyId" class="form-select rounded-3">
                <option value="">Seleccione moneda...</option>
                @if (Model.Currencies != null)
                {
                    foreach (var c in Model.Currencies)
                    {
                        <option value="@c.Id">@c.NameCurrency</option>
                    }
                }
            </select>
            <span asp-validation-for="DestinationCurrencyId" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="RateValue" class="form-label fw-semibold small text-muted">Valor de la Tasa</label>
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0 rounded-start-3"><i class="bi bi-hash"></i></span>
                <input asp-for="RateValue" class="form-control rounded-end-3 border-start-0" type="number" step="5" placeholder="0.0000" />
            </div>
            <span asp-validation-for="RateValue" class="text-danger small"></span>
            <small class="text-muted">Ej: 1 USD = 60.50 DOP. Digite 60.50</small>
        </div>

        <div class="col-md-6">
            <label asp-for="EffectiveDate" class="form-label fw-semibold small text-muted">Fecha de Vigencia</label>
            <input asp-for="EffectiveDate" class="form-control rounded-3" type="date" />
            <span asp-validation-for="EffectiveDate" class="text-danger small"></span>
        </div>

        <div class="col-12 mt-3">
            <div class="form-check form-switch">
                <input asp-for="State" class="form-check-input" type="checkbox" id="stateSwitch">
                <label class="form-check-label fw-semibold text-muted" for="stateSwitch">Tasa Activa</label>
            </div>
        </div>
    </div>

    <div class="modal-footer mt-4 border-0 pt-3">
        <a asp-controller="ExchangeRates" asp-action="Index" class="btn btn-light rounded-3 px-4">Volver Atrás</a>
        <button type="submit" class="btn btn-primary rounded-3 px-4 shadow-sm ms-2">Guardar Tasa</button>
    </div>
</form>