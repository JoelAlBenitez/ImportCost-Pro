@using Application.ViewModel.ExchangeRates
@model List<ViewModelExchangeRate>

@{
    ViewData["Title"] = "Gestión de Tasas de Cambio";
}

<div class="container-fluid py-4">

    @* Mensaje de alerta *@
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-@TempData["TypeAlert"] w-auto alert-dismissible fade show shadow-sm border-0" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-4 align-items-center">
        <div class="col-12 col-md-6 col-lg-4 mb-3 mb-md-0">
            <div class="input-group shadow-sm rounded-3 overflow-hidden bg-white">
                <span class="input-group-text bg-white border-0 text-muted ps-3">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" id="liveSearch" class="form-control border-0 shadow-none py-2" placeholder="Buscar tasa..." maxlength="50" />
            </div>
        </div>

        <div class="col-12 col-md-6 text-md-end">
            <a asp-controller="ExchangeRates" asp-action="Create"
               class="btn btn-primary px-4 py-2 fw-semibold rounded-3 shadow-sm d-inline-flex align-items-center gap-2">
                <i class="bi bi-plus-circle"></i>
                Registrar Tasa
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 bg-light">
        <div class="row g-0 align-items-center">
            <div class="col-md-8 p-4 p-md-5">
                <h2 class="h4 fw-bold text-dark mb-2">Historial de Tasas de Cambio</h2>
                <p class="text-secondary mb-3 text-wrap">
                    Registra y gestiona los valores de conversión entre las monedas extranjeras y la moneda local.
                </p>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="exchangeRatesTable">
                        <thead class="table-light text-secondary text-uppercase" style="font-size: 0.70rem;">
                            <tr>
                                <th class="py-3 ps-4 fw-semibold">Moneda Origen</th>
                                <th class="py-3 fw-semibold">Moneda Destino</th>
                                <th class="py-3 fw-semibold">Valor Tasa</th>
                                <th class="py-3 fw-semibold">Fecha Vigencia</th>
                                <th class="py-3 fw-semibold text-center">Estado</th>
                                <th class="py-3 text-end pe-4 fw-semibold">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="border-top-0" id="tableBody">
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr class="paginationTable">
                                        <td class="ps-4 fw-semibold text-dark">@item.SourceCurrencyName</td>
                                        <td class="text-dark">@item.DestinationCurrencyName</td>
                                        <td class="text-primary fw-bold">@item.RateValue.ToString("N4")</td>
                                        <td class="text-secondary small">@item.EffectiveDate.ToShortDateString()</td>
                                        <td class="text-center">
                                            <span class="badge @(item.State ? "bg-primary" : "bg-danger") bg-opacity-10 text-@(item.State ? "primary" : "danger") border border-opacity-25 px-2 py-1 rounded-2 fw-normal">
                                                @(item.State ? "Activa" : "Inactiva")
                                            </span>
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="btn-group shadow-sm rounded-3">
                                                <a asp-controller="ExchangeRates" asp-action="Edit" asp-route-id="@item.key" class="btn btn-sm btn-light text-success border-end" title="Editar">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                <a asp-controller="ExchangeRates" asp-action="Delete" asp-route-key="@item.key" class="btn btn-sm btn-light text-danger" title="Eliminar">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="bi bi-graph-up-arrow fs-2 d-block mb-2 opacity-50"></i>
                                        No hay tasas registradas.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white border-top-0 p-3 d-flex justify-content-between align-items-center">
                    <span class="text-muted small">Mostrando @(Model?.Count ?? 0) tasas registradas</span>
                </div>
            </div>
        </div>
    </div>
</div>