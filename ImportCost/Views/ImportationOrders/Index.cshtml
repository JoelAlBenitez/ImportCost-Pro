@model IEnumerable<ImportCost.ViewModels.ImportationOrders.ImportationOrderViewModel>
@{
    ViewData["Title"] = "Órdenes de Importación";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-6">
        <div class="input-group shadow-sm rounded-3 bg-white w-75">
            <span class="input-group-text bg-transparent border-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" id="liveSearch" class="form-control border-0 bg-transparent" placeholder="Buscar orden...">
        </div>
    </div>
    <div class="col-md-6 text-end">
        <a asp-action="Create" class="btn btn-primary rounded-3 shadow-sm px-4 py-2 fw-semibold">
            <i class="bi bi-box-seam me-2"></i> Agregar Nueva
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4">
    <div class="mb-4">
        <h4 class="fw-bold text-dark mb-1">Órdenes de Importación</h4>
        <p class="text-muted small">Gestiona las órdenes del sistema. Crea, edita, calcula el landed cost o cierra órdenes.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
            <p class="text-muted mt-3 fw-semibold">No hay órdenes de importación registradas.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle border-top">
                <thead>
                    <tr class="text-muted small text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                        <th class="fw-semibold border-0 pb-3">No. Orden</th>
                        <th class="fw-semibold border-0 pb-3">Importador</th>
                        <th class="fw-semibold border-0 pb-3">Proveedor</th>
                        <th class="fw-semibold border-0 pb-3">Fecha</th>
                        <th class="fw-semibold border-0 pb-3">Estado</th>
                        <th class="fw-semibold border-0 pb-3">FOB Total</th>
                        <th class="fw-semibold border-0 pb-3 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="paginationTable">
                            <td class="fw-bold text-dark">@item.OrderId</td>
                            <td>@item.ImporterName</td>
                            <td>@item.SupplierName</td>
                            <td>@item.OrderDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.OrderState == "Abierta")
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">@item.OrderState</span>
                                }
                                else if (item.OrderState == "Calculada")
                                {
                                    <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-3 py-2">@item.OrderState</span>
                                }
                                else if (item.OrderState == "Cerrada")
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2">@item.OrderState</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2">@item.OrderState</span>
                                }
                            </td>
                            <td class="fw-semibold text-dark">@item.CurrencyCode @item.TotalFob.ToString("N2")</td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a asp-controller="OrderDetails" asp-action="Index" asp-route-orderId="@item.OrderId" class="btn btn-sm btn-light text-primary border-0" title="Ver Detalle/Productos">
                                        <i class="bi bi-box-seam"></i>
                                    </a>
                                    <a asp-controller="ImportationExpenses" asp-action="Index" asp-route-orderId="@item.OrderId" class="btn btn-sm btn-light text-warning border-0" title="Ver Gastos">
                                        <i class="bi bi-cash-coin"></i>
                                    </a>

                                    @if (item.OrderState == "Abierta")
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.OrderId" class="btn btn-sm btn-light text-success border-0" title="Editar">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.OrderId" method="post" class="d-inline" onsubmit="return confirm('¿Está seguro que desea eliminar esta orden?');">
                                            <button type="submit" class="btn btn-sm btn-light text-danger border-0" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }

                                    @if (item.OrderState != "Cerrada")
                                    {
                                        <form asp-controller="ImportationOrders" asp-action="CloseOrder" method="post" class="d-inline" onsubmit="return confirm('¿Estás seguro de que deseas cerrar esta orden? Una vez cerrada, no podrás modificarla ni agregar más gastos.');">
                                            <input type="hidden" name="orderId" value="@item.OrderId" />
                                            <button type="submit" class="btn btn-sm btn-light text-secondary border-0" title="Cerrar Orden">
                                                <i class="bi bi-lock-fill"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>