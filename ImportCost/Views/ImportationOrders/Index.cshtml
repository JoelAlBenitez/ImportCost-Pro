@model IEnumerable<ImportCost.ViewModels.ImportationOrders.ImportationOrderViewModel>
@{
    ViewData["Title"] = "Órdenes de Importación";
}

@if (TempData["Message"] != null)
{
    var alertType = TempData["TypeAlert"]?.ToString() == "error" ? "danger" : TempData["TypeAlert"];
    <div class="alert alert-@alertType alert-dismissible fade show shadow-sm rounded-3 mb-4 d-flex align-items-center" role="alert">
        <i class="bi bi-info-circle-fill fs-5 me-3"></i>
        <div>@TempData["Message"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row mb-4 align-items-center">
    <div class="col-md-6">
        <div class="input-group shadow-sm rounded-3 bg-white w-75">
            <span class="input-group-text bg-transparent border-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" id="liveSearch" class="form-control border-0 bg-transparent" placeholder="Buscar orden...">
        </div>
    </div>
    <div class="col-md-6 text-end">
        <a asp-action="Create" class="btn btn-primary rounded-3 shadow-sm px-4 py-2 fw-semibold">
            <i class="bi bi-box-seam me-2"></i> Agregar Nueva
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4">
    <div class="mb-4">
        <h4 class="fw-bold text-dark mb-1">Órdenes de Importación</h4>
        <p class="text-muted small">Gestiona las órdenes del sistema. Crea, edita, calcula el landed cost o cierra órdenes.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
            <p class="text-muted mt-3 fw-semibold">No hay órdenes de importación registradas.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle border-top">
                <thead>
                    <tr class="text-muted small text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                        <th class="fw-semibold border-0 pb-3">No. Orden</th>
                        <th class="fw-semibold border-0 pb-3">Importador</th>
                        <th class="fw-semibold border-0 pb-3">Proveedor</th>
                        <th class="fw-semibold border-0 pb-3">Fecha</th>
                        <th class="fw-semibold border-0 pb-3">Estado</th>
                        <th class="fw-semibold border-0 pb-3">FOB Total</th>
                        <th class="fw-semibold border-0 pb-3 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="paginationTable">
                            <td class="fw-bold text-dark">@item.OrderId</td>
                            <td>@item.ImporterName</td>
                            <td>@item.SupplierName</td>
                            <td>@item.OrderDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.OrderState == "Abierta")
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">@item.OrderState</span>
                                }
                                else if (item.OrderState == "Calculada")
                                {
                                    <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-3 py-2">@item.OrderState</span>
                                }
                                else if (item.OrderState == "Cerrada")
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2">@item.OrderState</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2">@item.OrderState</span>
                                }
                            </td>
                            <td class="fw-semibold text-dark">@item.CurrencyCode @item.TotalFob.ToString("N2")</td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a asp-controller="OrderDetails" asp-action="Index" asp-route-orderId="@item.OrderId" class="btn btn-sm btn-light text-primary border-0" title="Ver Detalle/Productos">
                                        <i class="bi bi-box-seam"></i>
                                    </a>
                                    <a asp-controller="ImportationExpenses" asp-action="Index" asp-route-orderId="@item.OrderId" class="btn btn-sm btn-light text-warning border-0" title="Ver Gastos">
                                        <i class="bi bi-cash-coin"></i>
                                    </a>

                                    @if (item.OrderState == "Abierta")
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.OrderId" class="btn btn-sm btn-light text-success border-0" title="Editar">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-light text-danger border-0" title="Eliminar" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.OrderId">
                                            <i class="bi bi-trash"></i>
                                        </button>

                                        <!-- Modal Eliminar -->
                                        <div class="modal fade" id="deleteModal-@item.OrderId" tabindex="-1" aria-labelledby="deleteModalLabel-@item.OrderId" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content border-0 shadow">
                                                    <div class="modal-header bg-danger text-white">
                                                        <h5 class="modal-title fs-5" id="deleteModalLabel-@item.OrderId"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Eliminación</h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body text-start">
                                                        <p class="mb-0 text-dark">¿Está seguro que desea eliminar la orden <strong>@item.OrderId</strong>?</p>
                                                        <p class="text-muted small mt-2 mb-0">Esta acción no se puede deshacer.</p>
                                                    </div>
                                                    <div class="modal-footer bg-light">
                                                        <button type="button" class="btn btn-secondary rounded-3" data-bs-dismiss="modal">Cancelar</button>
                                                        <form asp-action="Delete" asp-route-id="@item.OrderId" method="post" class="m-0">
                                                            <button type="submit" class="btn btn-danger rounded-3 fw-bold">Sí, eliminar</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    @if (item.OrderState != "Cerrada")
                                    {
                                        <button type="button" class="btn btn-sm btn-light text-secondary border-0" title="Cerrar Orden" data-bs-toggle="modal" data-bs-target="#closeModal-@item.OrderId">
                                            <i class="bi bi-lock-fill"></i>
                                        </button>

                                        <!-- Modal Cerrar Orden -->
                                        <div class="modal fade" id="closeModal-@item.OrderId" tabindex="-1" aria-labelledby="closeModalLabel-@item.OrderId" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content border-0 shadow">
                                                    <div class="modal-header bg-secondary text-white">
                                                        <h5 class="modal-title fs-5" id="closeModalLabel-@item.OrderId"><i class="bi bi-lock-fill me-2"></i>Confirmar Cierre</h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body text-start">
                                                        <p class="mb-0 text-dark">¿Estás seguro de que deseas cerrar la orden <strong>@item.OrderId</strong>?</p>
                                                        <p class="text-muted small mt-2 mb-0">Una vez cerrada, no podrás modificarla ni agregar más gastos.</p>
                                                    </div>
                                                    <div class="modal-footer bg-light">
                                                        <button type="button" class="btn btn-light border rounded-3" data-bs-dismiss="modal">Cancelar</button>
                                                        <form asp-controller="ImportationOrders" asp-action="CloseOrder" method="post" class="m-0">
                                                            <input type="hidden" name="orderId" value="@item.OrderId" />
                                                            <button type="submit" class="btn btn-secondary rounded-3 fw-bold">Sí, cerrar orden</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>