@model IEnumerable<ImportCost.ViewModels.ImportationExpenses.ExpenseViewModel>
@{
    ViewData["Title"] = "Gastos de Importación";
    var currentOrderId = ViewBag.CurrentOrderId as string;
}

@if (TempData["Message"] != null)
{
    var alertType = TempData["TypeAlert"]?.ToString() == "error" ? "danger" : TempData["TypeAlert"];
    <div class="alert alert-@alertType alert-dismissible fade show shadow-sm rounded-3 mb-4 d-flex align-items-center" role="alert">
        <i class="bi bi-info-circle-fill fs-5 me-3"></i>
        <div>@TempData["Message"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom gap-3">
        <div>
            <h4 class="fw-bold text-dark mb-1">Gastos de la Orden</h4>
            <span class="badge bg-warning bg-opacity-10 text-warning fs-6 px-3 py-2 rounded-pill">No. @currentOrderId</span>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="ImportationOrders" asp-action="Index" class="btn btn-light rounded-3 shadow-sm fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Volver a Órdenes
            </a>
            <a asp-controller="OrderDetails" asp-action="Index" asp-route-orderId="@currentOrderId" class="btn btn-primary rounded-3 shadow-sm fw-semibold text-white">
                <i class="bi bi-box-seam me-1"></i> Ver Productos
            </a>
            <a asp-action="Create" asp-route-orderId="@currentOrderId" class="btn btn-warning text-dark rounded-3 shadow-sm fw-bold">
                <i class="bi bi-plus-lg me-1"></i> Registrar Gasto
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-receipt text-muted" style="font-size: 3rem;"></i>
            <p class="text-muted mt-3 fw-semibold">Aún no hay gastos registrados para esta orden.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle border-top">
                <thead>
                    <tr class="text-muted small text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                        <th class="fw-semibold border-0 pb-3">Tipo de Gasto</th>
                        <th class="fw-semibold border-0 pb-3">Monto</th>
                        <th class="fw-semibold border-0 pb-3">Moneda</th>
                        <th class="fw-semibold border-0 pb-3">Distribución</th>
                        <th class="fw-semibold border-0 pb-3">Fecha</th>
                        <th class="fw-semibold border-0 pb-3 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="paginationTable">
                            <td class="fw-bold text-dark">@item.ExpenseType</td>
                            <td class="fw-semibold text-warning">@item.ExpenseAmount.ToString("N2")</td>
                            <td><span class="badge bg-light text-dark border">@item.CurrencyCode</span></td>
                            <td>@item.DistributionMethod</td>
                            <td>@item.ImportationExpenseDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@item.ImportationExpenseId" class="btn btn-sm btn-light text-success border-0" title="Editar">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-light text-danger border-0" title="Eliminar" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.ImportationExpenseId">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>

                                <div class="modal fade" id="deleteModal-@item.ImportationExpenseId" tabindex="-1" aria-labelledby="deleteModalLabel-@item.ImportationExpenseId" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content border-0 shadow">
                                            <div class="modal-header bg-danger text-white">
                                                <h5 class="modal-title fs-5" id="deleteModalLabel-@item.ImportationExpenseId">
                                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Eliminación
                                                </h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body text-start">
                                                <p class="mb-0 text-dark">¿Estás seguro que deseas eliminar el gasto de <strong>@item.ExpenseType</strong>?</p>
                                                <p class="text-muted small mt-2 mb-0">Esta acción no se puede deshacer.</p>
                                            </div>
                                            <div class="modal-footer bg-light">
                                                <button type="button" class="btn btn-secondary rounded-3" data-bs-dismiss="modal">Cancelar</button>
                                                <form asp-action="Delete" asp-route-id="@item.ImportationExpenseId" asp-route-orderId="@currentOrderId" method="post" class="m-0">
                                                    <button type="submit" class="btn btn-danger rounded-3 fw-bold">Sí, eliminar</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    }