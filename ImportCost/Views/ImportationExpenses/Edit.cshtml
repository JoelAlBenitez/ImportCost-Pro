@model ImportCost.ViewModels.ImportationExpenses.ExpenseEditViewModel
@{
    ViewData["Title"] = "Editar Gasto";
}

<div class="card border-0 shadow-sm rounded-4 p-4 mx-auto" style="max-width: 800px;">
    <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
        <div class="bg-success bg-opacity-10 p-3 rounded-3 me-3">
            <i class="bi bi-pencil-square text-success fs-4"></i>
        </div>
        <div>
            <h4 class="mb-0 fw-bold text-dark">Editar Gasto de Importación</h4>
            <small class="text-muted">Actualizando información financiera.</small>
        </div>
    </div>

    <form asp-action="Edit" method="POST">
        <input type="hidden" asp-for="ImportationExpenseId" />
        <input type="hidden" asp-for="OrderId" />

        <div class="row g-4">
            <div class="col-md-12">
                <label asp-for="OrderNumberDisplay" class="form-label fw-semibold small text-muted">Orden de Importación</label>
                <input asp-for="OrderNumberDisplay" class="form-control rounded-3 py-2 bg-light text-muted" value="@Model.OrderId" readonly />
            </div>

            <div class="col-md-6">
                <label asp-for="ExpenseType" class="form-label fw-semibold small text-muted"></label>
                <select asp-for="ExpenseType" asp-items="@Html.GetEnumSelectList<Persistence.Entities.Enums.ExpenseType>()" class="form-select rounded-3 py-2">
                </select>
                <span asp-validation-for="ExpenseType" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="DistributionMethod" class="form-label fw-semibold small text-muted"></label>
                <select asp-for="DistributionMethod" asp-items="@Html.GetEnumSelectList<Persistence.Entities.Enums.DistributionMethod>()" class="form-select rounded-3 py-2">
                </select>
                <span asp-validation-for="DistributionMethod" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="ExpenseAmount" class="form-label fw-semibold small text-muted"></label>
                <input asp-for="ExpenseAmount" type="number" step="0.01" class="form-control rounded-3 py-2" />
                <span asp-validation-for="ExpenseAmount" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="CurrencyId" class="form-label fw-semibold small text-muted"></label>
                <select asp-for="CurrencyId" asp-items="@(new SelectList(Model.CurrenciesList, "Id", "NameCurrency"))" class="form-select rounded-3 py-2">
                </select>
                <span asp-validation-for="CurrencyId" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="ImportationExpenseDate" class="form-label fw-semibold small text-muted"></label>
                <input asp-for="ImportationExpenseDate" type="date" class="form-control rounded-3 py-2" />
                <span asp-validation-for="ImportationExpenseDate" class="text-danger small"></span>
            </div>
        </div>

        <div class="mt-5 pt-4 border-top text-end">
            <a asp-action="Index" asp-route-orderId="@Model.OrderId" class="btn btn-light rounded-3 px-4 shadow-sm me-2 fw-semibold">Cancelar</a>
            <button type="submit" class="btn btn-success rounded-3 px-4 shadow-sm fw-bold">Guardar Cambios</button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}