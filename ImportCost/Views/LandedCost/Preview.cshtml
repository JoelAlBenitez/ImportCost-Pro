@model ImportCost.ViewModels.LandedCosts.LandedCostSummaryViewModel
@{
    ViewData["Title"] = "Vista Previa del Landed Cost";
}

<div class="card border-0 shadow-sm rounded-4 p-4 mx-auto" style="max-width: 1200px;">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom gap-3">
        <div class="d-flex align-items-center">
            <div class="bg-primary bg-opacity-10 p-3 rounded-3 me-3">
                <i class="bi bi-calculator text-primary fs-3"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-bold text-dark">Análisis de Landed Cost</h4>
                <small class="text-muted">Vista previa del cálculo para la Orden <span class="badge bg-secondary">@Model.OrderId</span></small>
            </div>
        </div>
        <div class="text-end">
            <span class="d-block text-muted small fw-semibold">Moneda Base: <span class="text-dark">@Model.LocalCurrencyUsed</span></span>
            <span class="d-block text-muted small fw-semibold">Tasa de Cambio (Orden): <span class="text-dark">@Model.ExchangeRate.ToString("N2")</span></span>
        </div>
    </div>

    <div class="row g-3 mb-5">
        <div class="col-md-3">
            <div class="p-3 bg-light rounded-3 border">
                <small class="text-muted fw-semibold text-uppercase" style="font-size: 0.7rem;">FOB Total Local</small>
                <h5 class="fw-bold text-dark mb-0 mt-1">@Model.LocalTotalFob.ToString("N2")</h5>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-3 bg-light rounded-3 border">
                <small class="text-muted fw-semibold text-uppercase" style="font-size: 0.7rem;">Flete & Seguro</small>
                <h5 class="fw-bold text-dark mb-0 mt-1">@((Model.TotalFreight + Model.TotalInsurance).ToString("N2"))</h5>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-3 bg-light rounded-3 border">
                <small class="text-muted fw-semibold text-uppercase" style="font-size: 0.7rem;">Impuestos (Arancel + ITBIS...)</small>
                <h5 class="fw-bold text-dark mb-0 mt-1">@((Model.TotalTariff + Model.TotalItbis + Model.TotalSelectiveTax + Model.TotalCustomsServiceFee).ToString("N2"))</h5>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-3 bg-primary bg-opacity-10 border border-primary border-opacity-25 rounded-3">
                <small class="text-primary fw-bold text-uppercase" style="font-size: 0.7rem;">Costo Total Importado</small>
                <h4 class="fw-bold text-primary mb-0 mt-1">@Model.LocalCurrencyUsed @Model.TotalImportationCost.ToString("N2")</h4>
            </div>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-md-12">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-list-check me-2"></i>Desglose de Gastos e Impuestos</h6>
            <div class="d-flex flex-wrap gap-4 text-muted small">
                <span><strong>Flete:</strong> @Model.TotalFreight.ToString("N2")</span>
                <span><strong>Seguro:</strong> @Model.TotalInsurance.ToString("N2")</span>
                <span><strong>CIF Total:</strong> @Model.TotalCif.ToString("N2")</span>
                <span><strong>Arancel:</strong> @Model.TotalTariff.ToString("N2")</span>
                <span><strong>Servicio Aduanal:</strong> @Model.TotalCustomsServiceFee.ToString("N2")</span>
                <span><strong>ITBIS:</strong> @Model.TotalItbis.ToString("N2")</span>
                <span><strong>Gastos Locales:</strong> @Model.TotalLocalExpenses.ToString("N2")</span>
            </div>
        </div>
    </div>

    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-box-seam me-2"></i>Detalle por Producto (@Model.TotalImportedQuantity.ToString("N2") unidades)</h6>
    <div class="table-responsive border rounded-3 mb-5">
        <table class="table table-hover table-striped align-middle mb-0" style="font-size: 0.85rem;">
            <thead class="table-light">
                <tr class="text-uppercase text-muted" style="letter-spacing: 0.5px;">
                    <th>Producto</th>
                    <th class="text-center">Cant.</th>
                    <th class="text-end">FOB Local</th>
                    <th class="text-end">CIF Asignado</th>
                    <th class="text-end">Impuestos</th>
                    <th class="text-end">Gastos Locales</th>
                    <th class="text-end bg-primary bg-opacity-10 text-primary">Costo Total</th>
                    <th class="text-end bg-success bg-opacity-10 text-success">Costo Unit.</th>
                    <th class="text-end bg-warning bg-opacity-10 text-dark">Precio Venta</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.ProductDetails)
                {
                    <tr>
                        <td class="fw-semibold text-dark">@p.ProductName</td>
                        <td class="text-center">@p.Quantity.ToString("N2")</td>
                        <td class="text-end text-muted">@p.LocalTotalFob.ToString("N2")</td>
                        <td class="text-end text-muted">@p.TotalCif.ToString("N2")</td>
                        <td class="text-end text-danger">@((p.TotalTariff + p.TotalSelectiveTax + p.TotalCustomsServiceFee + p.TotalItbis).ToString("N2"))</td>
                        <td class="text-end text-muted">@p.AssignedLocalExpenses.ToString("N2")</td>
                        <td class="text-end fw-bold text-primary bg-primary bg-opacity-10">@p.TotalImportedCost.ToString("N2")</td>
                        <td class="text-end fw-bold text-success bg-success bg-opacity-10">@p.UnitImportedCost.ToString("N2")</td>
                        <td class="text-end fw-bold text-dark bg-warning bg-opacity-10">
                            @p.SuggestedSalePrice.ToString("N2")
                            <br /><span class="badge bg-white text-muted border" style="font-size: 0.65rem;">Margen: @p.DesiredMargin.ToString("N2")%</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
        <a asp-controller="ImportationOrders" asp-action="Index" class="btn btn-light rounded-3 px-4 shadow-sm fw-semibold">
            <i class="bi bi-x-circle me-2"></i> Cancelar / Volver
        </a>

        <form asp-action="Save" method="post" onsubmit="return confirm('¿Está seguro de confirmar este cálculo? Una vez guardado, la orden pasará a estado Calculada y no podrá ser modificada.');">
            <input type="hidden" name="orderId" value="@Model.OrderId" />
            <button type="submit" class="btn btn-success rounded-3 px-5 shadow-sm fw-bold fs-6">
                <i class="bi bi-check-circle-fill me-2"></i> Guardar Cálculo Oficial
            </button>
        </form>
    </div>
</div>