@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Calcular Landed Cost";
}

<div class="card border-0 shadow-sm rounded-4 p-4 mx-auto mt-5" style="max-width: 600px;">
    <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
        <div class="bg-primary bg-opacity-10 p-3 rounded-3 me-3">
            <i class="bi bi-calculator text-primary fs-3"></i>
        </div>
        <div>
            <h4 class="mb-0 fw-bold text-dark">Calcular Landed Cost</h4>
            <small class="text-muted">Seleccione una orden abierta para procesar.</small>
        </div>
    </div>

    <form asp-action="Preview" method="GET">
        <div class="mb-4">
            <label for="orderId" class="form-label fw-semibold text-muted small">Orden de Importación</label>

            @if (ViewBag.OrdersList != null && ((IEnumerable<SelectListItem>)ViewBag.OrdersList).Any())
            {
                <select name="orderId" id="orderId" class="form-select rounded-3 py-2 shadow-sm" asp-items="@ViewBag.OrdersList">
                </select>
            }
            else
            {
                <select disabled class="form-select rounded-3 py-2 bg-light">
                    <option>No hay órdenes abiertas disponibles...</option>
                </select>
                <small class="text-danger mt-2 d-block"><i class="bi bi-exclamation-circle me-1"></i> Debe crear una orden y dejarla abierta para poder calcularla.</small>
            }
        </div>

        <div class="text-end border-top pt-4">
            <button type="submit" class="btn btn-primary rounded-3 px-4 shadow-sm fw-bold" @(ViewBag.OrdersList == null || !((IEnumerable<SelectListItem>)ViewBag.OrdersList).Any() ? "disabled" : "")>
                <i class="bi bi-gear-fill me-2"></i> Calcular landed cost
            </button>
        </div>
    </form>
</div>