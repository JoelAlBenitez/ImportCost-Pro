@using Application.ViewModel.TarriffCategories
@model List<ViewModelTarriffCategories>

@{
    ViewData["Title"] = "Gestión de Categorías Arancelarias";
}

<div class="container-fluid py-4">

    @* Mensaje que retorna el controller según lo que haya pasado *@
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-@TempData["TypeAlert"] w-auto alert-dismissible fade show shadow-sm border-0" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-4 align-items-center">
        <div class="col-12 col-md-6 col-lg-4 mb-3 mb-md-0">
            <div class="input-group shadow-sm rounded-3 overflow-hidden bg-white">
                <span class="input-group-text bg-white border-0 text-muted ps-3">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" id="liveSearch" class="form-control border-0 shadow-none py-2" placeholder="Buscar categoría..." maxlength="20" />
            </div>
        </div>

        <div class="col-12 col-md-6 text-md-end">
            <a asp-controller="Tariff" asp-action="Create"
               class="btn btn-primary px-4 py-2 fw-semibold rounded-3 shadow-sm d-inline-flex align-items-center gap-2">
                <i class="bi bi-plus-circle"></i>
                Agregar Categoría
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 bg-light">
        <div class="row g-0 align-items-center">
            <div class="col-md-8 p-4 p-md-5">
                <h2 class="h4 fw-bold text-dark mb-2">Categorías Arancelarias</h2>
                <p class="text-secondary mb-3 text-wrap">
                    Configura los porcentajes de aranceles, ITBIS e Impuestos Selectivos al Consumo (ISC) aplicables a las importaciones del sistema.
                </p>
            </div>
           
        </div>
    </div>

    <div class="row gap-4 gap-lg-0">

        <div class="col-12 col-lg-2">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="list-group list-group-flush rounded-3">
                    <a asp-controller="Tariff" asp-action="Index" class="list-group-item list-group-item-action active fw-semibold border-0 py-3 d-flex align-items-center gap-2">
                        <i class="bi bi-tags"></i> Categoría Arancelaria
                    </a>
                    <a asp-controller="Products" asp-action="Index" class="list-group-item list-group-item-action border-0 py-3 text-secondary d-flex align-items-center gap-2">
                        <i class="bi bi-box-seam"></i> Products
                    </a>
                    <a asp-controller="TaxConfiguration" asp-action="Index" class="list-group-item list-group-item-action border-0 py-3 text-secondary d-flex align-items-center gap-2">
                        <i class="bi bi-gear"></i> Configuración Categorías
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-10">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="tariffTable">
                        <thead class="table-light text-secondary text-uppercase" style="font-size: 0.95rem;">
                            <tr>
                                <th class="py-3 ps-4 fw-semibold">Código</th>
                                <th class="py-3 fw-semibold">Nombre</th>
                                <th class="py-3 fw-semibold">Arancel (%)</th>
                                <th class="py-3 fw-semibold">Aplica ITBIS</th>
                                <th class="py-3 fw-semibold">Aplica ISC</th>
                                <th class="py-3 fw-semibold">ISC (%)</th>
                                <th class="py-3 fw-semibold">Estado</th>
                                <th class="py-3 text-end pe-4 fw-semibold">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="border-top-0" id="tableBody">
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4 text-muted font-monospace fw-bold small">@item.key</td>
                                        <td class="fw-semibold text-dark">@item.Name</td>

                                        <td class="text-secondary fw-semibold">
                                            @item.PorcentageTariff.ToString("0.00")%
                                        </td>

                                        <td>
                                            @if (item.ITBIS)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 rounded-2 fw-normal">Sí</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1 rounded-2 fw-normal">No</span>
                                            }
                                        </td>

                                        <td>
                                            @if (item.SelectiveTaxApplies)
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1 rounded-2 fw-normal">Sí</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1 rounded-2 fw-normal">No</span>
                                            }
                                        </td>

                                        <td class="text-secondary small">
                                            @(item.PorcentageTaxSelective > 0 ? $"{item.PorcentageTaxSelective?.ToString("0.00")}%" : "N/A")
                                        </td>

                                        <td>
                                            <span class="badge @(item.State ? "bg-primary" : "bg-danger") bg-opacity-10 @(item.State ? "text-primary" : "text-danger") px-2 py-1 rounded-2 fw-normal border @(item.State ? "border-primary" : "border-danger") border-opacity-25">
                                                @(item.State ? "Activo" : "Inactivo")
                                            </span>
                                        </td>

                                        <td class="text-end pe-4">
                                            <div class="btn-group shadow-sm rounded-3">
                                                <a data-modal="true" asp-controller="Tariff" asp-action="Edit" asp-route-id="@item.key" class="btn btn-sm btn-light text-success border-end" title="Editar">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                <a data-modal="true" asp-controller="Tariff" asp-action="Delete" asp-route-id="@item.key" class="btn btn-sm btn-light text-danger" title="Eliminar">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr id="noDataRow">
                                    <td colspan="8" class="text-center py-5 text-muted">
                                        <i class="bi bi-tags fs-2 d-block mb-2 opacity-50"></i>
                                        No hay categorías arancelarias registradas.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card-footer bg-white border-top-0 p-3 d-flex justify-content-between align-items-center">
                    <span class="text-muted small" id="paginationInfo">Mostrando @(Model?.Count ?? 0) categorías</span>
                    <nav>
                        <ul class="pagination pagination-sm mb-0" id="paginationControls">
                        </ul>
                    </nav>
                </div>
            </div>
        </div>

    </div>
</div>