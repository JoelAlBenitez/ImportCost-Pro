@using Application.ViewModel.TarriffCategories
@model ViewModelTarriffCategoriesSave

    @* Mensaje de alerta *@
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-@TempData["TypeAlert"] w-auto alert-dismissible fade show shadow-sm border-0" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="card-header bg-white border-0 p-0 mb-4">
        <h5 class="fw-bold text-dark">Registrar Categoría Arancelaria</h5>
        <p class="text-muted small">Complete los detalles para crear una nueva categoría en el sistema.</p>
    </div>

    <form asp-controller="Tariff" asp-action="Create" method="POST">
        <div class="row g-3">

            <div class="col-md-6">
                <label asp-for="TarriffCode" class="form-label fw-semibold small text-muted">Código de Arancel</label>
                <input asp-for="TarriffCode" class="form-control rounded-3" placeholder="Ej: TAR-001" />
                <span asp-validation-for="TarriffCode" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Name" class="form-label fw-semibold small text-muted">Nombre/Descripción</label>
                <input asp-for="Name" class="form-control rounded-3" placeholder="Ej: Electrónicos" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="TarriffPorcetage" class="form-label fw-semibold small text-muted">Porcentaje Arancel (%)</label>
                <input asp-for="TarriffPorcetage" type="number" class="form-control rounded-3" />
                <span asp-validation-for="TarriffPorcetage" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="PorcentageTaxSelective" class="form-label fw-semibold small text-muted">Impuesto Selectivo (%)</label>
                <input asp-for="PorcentageTaxSelective" type="number"  class="form-control rounded-3" />
                <span asp-validation-for="PorcentageTaxSelective" class="text-danger small"></span>
            </div>

            <div class="col-md-4 d-flex align-items-end pb-2">
                <div class="form-check form-switch">
                    <input asp-for="State" class="form-check-input" type="checkbox" id="stateSwitch" checked>
                    <label class="form-check-label fw-semibold text-muted" for="stateSwitch">Categoría Activa</label>
                </div>
            </div>

            <div class="col-12 mt-3">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-check">
                            <input asp-for="ITBIS" class="form-check-input" type="checkbox" id="itbisCheck">
                            <label class="form-check-label fw-semibold text-muted" for="itbisCheck">Aplicar ITBIS</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check">
                            <input asp-for="SelectiveTaxApplies" class="form-check-input" type="checkbox" id="iscCheck">
                            <label class="form-check-label fw-semibold text-muted" for="iscCheck">Aplicar Impuesto Selectivo</label>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="modal-footer mt-4 border-0 pt-3">
            <a asp-controller="Tariff" asp-action="Index" class="btn btn-light rounded-3 px-4">Volver Atrás</a>
            <button type="submit" class="btn btn-primary rounded-3 px-4 shadow-sm ms-2">Guardar Categoría</button>
        </div>
    </form>
