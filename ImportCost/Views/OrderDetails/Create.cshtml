@model ImportCost.ViewModels.OrderDetails.OrderDetailCreateViewModel
@{
    ViewData["Title"] = "Agregar Producto";
}

<div class="card border-0 shadow-sm rounded-4 p-4 mx-auto" style="max-width: 800px;">
    <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
        <div class="bg-primary bg-opacity-10 p-3 rounded-3 me-3">
            <i class="bi bi-cart-plus text-primary fs-4"></i>
        </div>
        <div>
            <h4 class="mb-0 fw-bold text-dark">Agregar Producto a la Orden</h4>
            <small class="text-muted">Orden No. <span class="fw-bold">@Model.OrderId</span></small>
        </div>
    </div>

    <form asp-action="Create" method="POST">
        <input type="hidden" asp-for="OrderId" />

        <div class="row g-4">
            <div class="col-md-12">
                <label asp-for="ProductId" class="form-label fw-semibold small text-muted"></label>
                <select asp-for="ProductId" asp-items="@(new SelectList(Model.ProductsList, "CodeReference", "ProductName"))" class="form-select rounded-3 py-2">
                    <option value="">Seleccione un producto del catálogo...</option>
                </select>
                <span asp-validation-for="ProductId" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Quantity" class="form-label fw-semibold small text-muted"></label>
                <input asp-for="Quantity" type="number" step="0.01" class="form-control rounded-3 py-2" placeholder="Ej: 100" />
                <span asp-validation-for="Quantity" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="FOBUnitPrice" class="form-label fw-semibold small text-muted"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-currency-dollar"></i></span>
                    <input asp-for="FOBUnitPrice" type="number" step="0.01" class="form-control rounded-3 border-start-0 py-2" placeholder="0.00" />
                </div>
                <span asp-validation-for="FOBUnitPrice" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="ExpectedProfitMargin" class="form-label fw-semibold small text-muted"></label>
                <div class="input-group">
                    <input asp-for="ExpectedProfitMargin" type="number" step="0.01" class="form-control rounded-3 border-end-0 py-2" placeholder="Ej: 30" />
                    <span class="input-group-text bg-light border-start-0">%</span>
                </div>
                <span asp-validation-for="ExpectedProfitMargin" class="text-danger small"></span>
            </div>
        </div>

        <div class="mt-5 pt-4 border-top text-end">
            <a asp-action="Index" asp-route-orderId="@Model.OrderId" class="btn btn-light rounded-3 px-4 shadow-sm me-2 fw-semibold">Cancelar</a>
            <button type="submit" class="btn btn-primary rounded-3 px-4 shadow-sm fw-semibold">Guardar Producto</button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}