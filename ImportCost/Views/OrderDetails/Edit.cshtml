@model ImportCost.ViewModels.OrderDetails.OrderDetailEditViewModel
@{
    ViewData["Title"] = "Editar Producto";
}

<div class="card border-0 shadow-sm rounded-4 p-4 mx-auto" style="max-width: 800px;">
    <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
        <div class="bg-success bg-opacity-10 p-3 rounded-3 me-3">
            <i class="bi bi-pencil-square text-success fs-4"></i>
        </div>
        <div>
            <h4 class="mb-0 fw-bold text-dark">Editar Detalles del Producto</h4>
            <small class="text-muted">Orden No. <span class="fw-bold">@Model.OrderId</span></small>
        </div>
    </div>

    <form asp-action="Edit" method="POST">
        <input type="hidden" asp-for="OrderDetailId" />
        <input type="hidden" asp-for="OrderId" />
        <input type="hidden" asp-for="ProductId" />

        <div class="row g-4">
            <div class="col-md-12">
                <label asp-for="ProductName" class="form-label fw-semibold small text-muted"></label>
                <input asp-for="ProductName" class="form-control rounded-3 py-2 bg-light text-muted" readonly />
            </div>

            <div class="col-md-4">
                <label asp-for="Quantity" class="form-label fw-semibold small text-muted"></label>
                <input asp-for="Quantity" type="number" step="0.01" class="form-control rounded-3 py-2" />
                <span asp-validation-for="Quantity" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="FOBUnitPrice" class="form-label fw-semibold small text-muted"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-currency-dollar"></i></span>
                    <input asp-for="FOBUnitPrice" type="number" step="0.01" class="form-control rounded-3 border-start-0 py-2" />
                </div>
                <span asp-validation-for="FOBUnitPrice" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="ExpectedProfitMargin" class="form-label fw-semibold small text-muted"></label>
                <div class="input-group">
                    <input asp-for="ExpectedProfitMargin" type="number" step="0.01" class="form-control rounded-3 border-end-0 py-2" />
                    <span class="input-group-text bg-light border-start-0">%</span>
                </div>
                <span asp-validation-for="ExpectedProfitMargin" class="text-danger small"></span>
            </div>
        </div>

        <div class="mt-5 pt-4 border-top text-end">
            <a asp-action="Index" asp-route-orderId="@Model.OrderId" class="btn btn-light rounded-3 px-4 shadow-sm me-2 fw-semibold">Cancelar</a>
            <button type="submit" class="btn btn-success rounded-3 px-4 shadow-sm fw-semibold">Guardar Cambios</button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}