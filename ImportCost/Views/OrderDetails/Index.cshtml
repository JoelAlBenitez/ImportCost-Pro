@model IEnumerable<ImportCost.ViewModels.OrderDetails.OrderDetailEditViewModel>
@{
    ViewData["Title"] = "Detalle de Productos";
    var currentOrderId = ViewBag.CurrentOrderId as string;
}

<div class="card border-0 shadow-sm rounded-4 p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom gap-3">
        <div>
            <h4 class="fw-bold text-dark mb-1">Productos de la Orden</h4>
            <span class="badge bg-primary bg-opacity-10 text-primary fs-6 px-3 py-2 rounded-pill">No. @currentOrderId</span>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="ImportationOrders" asp-action="Index" class="btn btn-light rounded-3 shadow-sm fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
            <a asp-controller="ImportationExpenses" asp-action="Index" asp-route-orderId="@currentOrderId" class="btn btn-warning rounded-3 shadow-sm fw-semibold">
                <i class="bi bi-cash-coin me-1"></i> Ver Gastos
            </a>
            <a asp-action="AddProductToOrderAsync" asp-route-orderId="@currentOrderId" class="btn btn-primary rounded-3 shadow-sm fw-semibold">
                <i class="bi bi-plus-lg me-1"></i> Agregar Producto
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-box-seam text-muted" style="font-size: 3rem;"></i>
            <p class="text-muted mt-3 fw-semibold">Aún no hay productos en esta orden.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle border-top">
                <thead>
                    <tr class="text-muted small text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                        <th class="fw-semibold border-0 pb-3">Producto</th>
                        <th class="fw-semibold border-0 pb-3">Cantidad</th>
                        <th class="fw-semibold border-0 pb-3">Precio FOB</th>
                        <th class="fw-semibold border-0 pb-3">Total FOB</th>
                        <th class="fw-semibold border-0 pb-3">Margen (%)</th>
                        <th class="fw-semibold border-0 pb-3 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="paginationTable">
                            <td class="fw-bold text-dark">@item.ProductName</td>
                            <td>@item.Quantity.ToString("N2")</td>
                            <td>@item.FOBUnitPrice.ToString("N2")</td>
                            <td class="fw-semibold text-primary">@item.TotalFOB.ToString("N2")</td>
                            <td><span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2">@item.ExpectedProfitMargin.ToString("N2")%</span></td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@item.OrderDetailId" class="btn btn-sm btn-light text-success border-0" title="Editar">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.OrderDetailId" asp-route-orderId="@currentOrderId" method="post" class="d-inline" onsubmit="return confirm('¿Desea eliminar este producto de la orden?');">
                                        <button type="submit" class="btn btn-sm btn-light text-danger border-0" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-4 p-3 bg-light rounded-3 d-flex justify-content-end align-items-center gap-3">
            <span class="text-muted fw-semibold">FOB Total de la Orden:</span>
            <span class="fs-5 fw-bold text-primary">@Model.Sum(x => x.TotalFOB).ToString("N2")</span>
        </div>
    }
</div>