@using Application.ViewModel.TaxConfigurations
@model ViewModelTaxConfigurationSave

@{
    ViewData["Title"] = "Configurar Impuestos";
}

<div class="card-header bg-white border-0 p-0 mb-4">
    <h5 class="fw-bold text-dark">Nueva Configuración de Impuestos</h5>
</div>

@* Mensaje de alerta *@
@if (TempData["Message"] != null)
{
    <div class="alert alert-@TempData["TypeAlert"] w-auto alert-dismissible fade show shadow-sm border-0" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form asp-controller="TaxConfigurations" asp-action="Create" method="POST">
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="GeneralItbisPercentage" class="form-label fw-semibold small text-muted">Porcentaje General de ITBIS (%)</label>
            <div class="input-group">
                <input asp-for="GeneralItbisPercentage" class="form-control rounded-start-3" type="number" step="0.01" placeholder="Ej: 18.00" />
                <span class="input-group-text bg-light rounded-end-3">%</span>
            </div>
            <span asp-validation-for="GeneralItbisPercentage" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="CustomsServiceRatePercentage" class="form-label fw-semibold small text-muted">Porcentaje de Tasa Aduanal (%)</label>
            <div class="input-group">
                <input asp-for="CustomsServiceRatePercentage" class="form-control rounded-start-3" type="number" step="0.01" placeholder="Ej: 0.40" />
                <span class="input-group-text bg-light rounded-end-3">%</span>
            </div>
            <span asp-validation-for="CustomsServiceRatePercentage" class="text-danger small"></span>
        </div>

        <div class="col-12 mt-3">
            <div class="form-check form-switch">
                <input asp-for="State" class="form-check-input" type="checkbox" id="stateSwitch">
                <label class="form-check-label fw-semibold text-muted" for="stateSwitch">Configuración Activa</label>
            </div>
        </div>
    </div>

    <div class="modal-footer mt-4 border-0 pt-3">
        <a asp-controller="TaxConfigurations" asp-action="Index" class="btn btn-light rounded-3 px-4">Volver Atrás</a>
        <button type="submit" class="btn btn-primary rounded-3 px-4 shadow-sm ms-2">Guardar Configuración</button>
    </div>
</form>